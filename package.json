{
  "name": "booklens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "书镜 BookLens — point your camera at a Chinese book, get summaries you can say out loud.",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cedict": "node scripts/build-cedict.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@fontsource/noto-serif-sc": "^5.2.5",
    "hanzi-writer": "^3.7.3",
    "idb": "^8.0.3",
    "motion": "^12.42.2",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
